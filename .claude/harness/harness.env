# harness.env — verify-before-stop.sh 가 source 하는 기계 판독 설정.
# install.sh 가 이 템플릿을 프로젝트의 .claude/harness/harness.env 로 복사하고,
# 프로필 §3(검증 명령)에서 값을 채운다. 사람이 직접 채워도 된다.
#
# 규칙: 셸에서 바로 도는 한 줄 명령. 비우면 Stop 훅이 타입체크를 생략한다
#       (타입 없는 언어나 타입체크가 없는 프로젝트).

# 타입체크 명령 (Stop 훅이 완료 게이트에서 실행). 예:
#   HARNESS_TYPECHECK_CMD="pnpm typecheck"
#   HARNESS_TYPECHECK_CMD="pnpm tsc --noEmit"
#   HARNESS_TYPECHECK_CMD="npm run typecheck"
#   HARNESS_TYPECHECK_CMD="cargo check"
#   HARNESS_TYPECHECK_CMD="go build ./..."
#   HARNESS_TYPECHECK_CMD="mypy ."
#
# PokeClip 모노레포: 현재 코드는 site/ 뿐이라 site 타입체크가 정본.
# 서비스 코드(plugin/·media-origin/·services/*)가 생기면 이 명령을
# 경로별 체인으로 확장한다 (프로필 3장 참조).
HARNESS_TYPECHECK_CMD="cd site && npx tsc -b"
